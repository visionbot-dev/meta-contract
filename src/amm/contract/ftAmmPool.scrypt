import "../../mcp02/contract/token/tokenProto.scrypt";
import "../../mcp02/contract/protoheader.scrypt";
import "../../mcp02/contract/txUtil.scrypt";
import "../../mcp02/contract/backtrace.scrypt";

/**
 * FtAmmPool：MCP02 FT-FT 恒定乘积 AMM 池（v4.0，由 PoolGenesis issue 创建）
 *
 * 设计要点：
 * - 池由 `FtAmmPoolGenesis` 一次性 issue 产生（genesisTxid = PoolGenesis outpoint），
 *   之后所有操作都是普通操作：无首次特判、无 OP_INIT；
 * - 池状态（reserveA/reserveB/lpReserve）不写入 data part，
 *   由“与旧池 UTXO 同一笔交易创建、固定输出序号”的储备 FT 承载；
 * - 交易输入布局固定：0=旧池, 1/2/3=FT-A/B/LP 储备, 4=用户输入,
 *   5=ADD 的第二个用户输入；不再暴露 inputIndex 参数；
 * - 储备 FT 必须与旧池同 tx（prevout txid + outputIndex 强绑定）；
 * - 池 UTXO data part 只保留标准 MCP02 FT 数据（静态），tokenAddress
 *   每次更新 input/output 一致，现有索引器可识别为普通 FT 找回；
 * - 池 UTXO 采用 TokenGenesis 链式更新：每次操作通过 Backtrace.verify 回溯。
 */
contract FtAmmPool {
    // 构造参数（不可变，写入 code part）
    bytes tokenACodeHash;
    bytes tokenAID;
    bytes tokenBCodeHash;
    bytes tokenBID;
    bytes lpTokenCodeHash;
    bytes lpTokenID;
    int minReserve;
    int feeBps;
    static const int OP_SWAP = 1;
    static const int OP_ADD = 2;
    static const int OP_REMOVE = 3;
    static const int SWAP_A_TO_B = 1;
    static const int SWAP_B_TO_A = 2;

    // 固定交易输入布局
    static const int POOL_INPUT_INDEX = 0;
    static const int RESERVE_A_INPUT_INDEX = 1;
    static const int RESERVE_B_INPUT_INDEX = 2;
    static const int LP_INPUT_INDEX = 3;
    static const int USER_INPUT_INDEX = 4;   // SWAP 用户输入 / ADD A / REMOVE LP
    static const int USER_INPUT_INDEX2 = 5;  // ADD B

    // 64 位有符号 int 最大值（M2 溢出防护）
    static const int INT_MAX = 9223372036854775807;

    // 安全乘法：溢出前拒绝
    static function mul(int a, int b) : int {
        require(a == 0 || b <= INT_MAX / a);
        return a * b;
    }

    // 安全加法：溢出前拒绝
    static function add(int a, int b) : int {
        require(a <= INT_MAX - b);
        return a + b;
    }

    // 校验一枚储备 FT：真实性 + ID/codehash/address，返回金额
    static function readReserve(
        bytes script,
        TxOutputProof proof,
        bytes tokenID,
        bytes tokenCodeHash,
        bytes poolAddress,
        bytes prevouts,
        int inputIndex
    ) : int {
        TxUtil.verifyTxOutput(proof, prevouts[inputIndex * TxUtil.OUTPOINT_LEN : (inputIndex + 1) * TxUtil.OUTPOINT_LEN]);
        require(sha256(script) == proof.scriptHash);
        int scriptLen = len(script);
        require(TokenProto.getTokenID(script, scriptLen) == tokenID);
        require(TokenProto.getScriptCodeHash(script, scriptLen) == tokenCodeHash);
        require(TokenProto.getTokenAddress(script, scriptLen) == poolAddress);
        return TokenProto.getTokenAmount(script, scriptLen);
    }

    // 校验用户 FT 输入（属于 userAddress 或 UserSigLock 合约地址、金额匹配）
    static function readUserInput(
        bytes script,
        TxOutputProof proof,
        bytes tokenID,
        bytes poolAddress,
        bytes userAddress,
        bytes userSigLockAddress,
        bytes prevouts,
        int inputIndex,
        int amount
    ) : int {
        TxUtil.verifyTxOutput(proof, prevouts[inputIndex * TxUtil.OUTPOINT_LEN : (inputIndex + 1) * TxUtil.OUTPOINT_LEN]);
        require(sha256(script) == proof.scriptHash);
        int scriptLen = len(script);
        require(TokenProto.getTokenID(script, scriptLen) == tokenID);
        require(TokenProto.getTokenAmount(script, scriptLen) == amount);
        // 用户输入 FT 可以是：1) 仍在用户地址（tokenAddress == userAddress）；
        // 2) 已预存到 UserSigLock 合约地址（tokenAddress == userSigLockAddress，由用户签名解锁，防截胡）
        bytes tokenAddr = TokenProto.getTokenAddress(script, scriptLen);
        require(tokenAddr == userAddress || tokenAddr == userSigLockAddress);
        return amount;
    }

    // 校验用户 LP 输入（REMOVE）
    static function readUserLp(
        bytes script,
        TxOutputProof proof,
        bytes lpTokenID,
        bytes lpTokenCodeHash,
        bytes poolAddress,
        bytes userAddress,
        bytes userSigLockAddress,
        bytes prevouts,
        int inputIndex,
        int amount
    ) : int {
        TxUtil.verifyTxOutput(proof, prevouts[inputIndex * TxUtil.OUTPOINT_LEN : (inputIndex + 1) * TxUtil.OUTPOINT_LEN]);
        require(sha256(script) == proof.scriptHash);
        int scriptLen = len(script);
        require(TokenProto.getTokenID(script, scriptLen) == lpTokenID);
        require(TokenProto.getScriptCodeHash(script, scriptLen) == lpTokenCodeHash);
        require(TokenProto.getTokenAmount(script, scriptLen) == amount);
        require(TokenProto.getTokenAddress(script, scriptLen) != poolAddress);
        bytes tokenAddr = TokenProto.getTokenAddress(script, scriptLen);
        require(tokenAddr == userAddress || tokenAddr == userSigLockAddress);
        return amount;
    }

    public function unlock(
        SigHashPreimage txPreimage,
        bytes prevouts,
        bytes poolScript,
        TxOutputProof poolProof,
        int op,
        int swapDirection,
        // 池内储备 FT 输入（输入序号固定 1/2/3）
        bytes oldTokenAScript,
        bytes oldTokenBScript,
        bytes oldLpScript,
        TxOutputProof proofA,
        TxOutputProof proofB,
        TxOutputProof proofLp,
        // 用户输入（SWAP/ADD/REMOVE）
        bytes userTokenScriptA,
        bytes userTokenScriptB,
        TxOutputProof userProofA,
        TxOutputProof userProofB,
        int amountAIn,
        int amountBIn,
        bytes userAddress,
        bytes userSigLockAddress,
        // 输出金额
        int amountAOut,
        int amountBOut,
        int lpMint,
        int lpReturn,
        bytes changeOutput,
        // remove 用：用户 LP 输入
        bytes oldLpUserScript,
        TxOutputProof lpUserProof,
        // 输出 satoshis
        int poolSatoshis,
        int reserveASatoshis,
        int reserveBSatoshis,
        int lpReserveSatoshis,
        int userASatoshis,
        int userBSatoshis,
        int lpUserSatoshis,
        // TokenGenesis 链式更新证明
        bytes poolTxHeader,
        int prevPoolInputIndex,
        TxInputProof poolTxInputProof,
        bytes prevPoolTxHeader,
        bytes prevPoolTxOutputHashProof,
        bytes prevPoolTxOutputSatoshiBytes
    ) {
        require(hash256(prevouts) == SigHash.hashPrevouts(txPreimage));

        // 池输入必须是当前 input 的 prevout，且传入脚本必须是链上真实完整锁定脚本
        // （SigHash.scriptCode 只是 OP_CODESEPARATOR 后的片段，不能用来算池地址/构造新池输出）
        bytes thisOutpoint = SigHash.outpoint(txPreimage);
        TxUtil.verifyTxOutput(poolProof, thisOutpoint);
        require(sha256(poolScript) == poolProof.scriptHash);
        int poolScriptLen = len(poolScript);

        // ========== 读取池 tokenAddress（用于保证 input/output 一致） ==========
        bytes poolTokenAddress = TokenProto.getTokenAddress(poolScript, poolScriptLen);

        // ========== LP 总供应量（与普通 FT 对齐：池 data part tokenAmount） ==========
        int lpTotalSupply = TokenProto.getTokenAmount(poolScript, poolScriptLen);

        // ========== TokenGenesis 链式更新 ==========
        // 池必须由 PoolGenesis issue 创建，genesisTxid 恒非 NULL（= PoolGenesis outpoint）
        bytes genesisTxid = TokenProto.getGenesisTxid(poolScript, poolScriptLen);
        {
            bytes prevScriptHash = sha256(poolScript);
            TxOutputProof prevPoolTxProof = {
                prevPoolTxHeader,
                prevPoolTxOutputHashProof,
                prevPoolTxOutputSatoshiBytes,
                prevScriptHash
            };
            Backtrace.verify(
                thisOutpoint,
                poolTxHeader,
                prevPoolInputIndex,
                prevPoolTxProof,
                genesisTxid,
                poolTxInputProof
            );
        }

        // ========== 校验池内储备 FT 输入（固定序号 1/2/3），读金额即 reserve ==========
        bytes poolAddress = hash160(poolScript);
        bytes poolTxid = SigHash.outpoint(txPreimage)[: 32];

        int reserveA_old = readReserve(oldTokenAScript, proofA, this.tokenAID, this.tokenACodeHash, poolAddress, prevouts, RESERVE_A_INPUT_INDEX);
        int reserveB_old = readReserve(oldTokenBScript, proofB, this.tokenBID, this.tokenBCodeHash, poolAddress, prevouts, RESERVE_B_INPUT_INDEX);
        int lpReserve_old = readReserve(oldLpScript, proofLp, this.lpTokenID, this.lpTokenCodeHash, poolAddress, prevouts, LP_INPUT_INDEX);

        // 储备 FT 必须来自创建旧池 UTXO 的同一笔交易（禁止第三方转入/捐赠 UTXO 参与）
        {
            require(prevouts[RESERVE_A_INPUT_INDEX * TxUtil.OUTPOINT_LEN : RESERVE_A_INPUT_INDEX * TxUtil.OUTPOINT_LEN + 32] == poolTxid);
            require(prevouts[RESERVE_B_INPUT_INDEX * TxUtil.OUTPOINT_LEN : RESERVE_B_INPUT_INDEX * TxUtil.OUTPOINT_LEN + 32] == poolTxid);
            require(prevouts[LP_INPUT_INDEX * TxUtil.OUTPOINT_LEN : LP_INPUT_INDEX * TxUtil.OUTPOINT_LEN + 32] == poolTxid);

            // 固定输出布局：pool=0, reserveA=1, reserveB=2, lpReserve=3
            // 只比 txid 不够：同一 tx 的 changeOutput 可能塞入池地址上的额外 FT，
            // 必须同时绑定 prevout outputIndex，确保取到的是“规范储备输出”
            require(SigHash.outpoint(txPreimage)[32 : 36] == b'00000000');
            require(prevouts[RESERVE_A_INPUT_INDEX * TxUtil.OUTPOINT_LEN + 32 : (RESERVE_A_INPUT_INDEX + 1) * TxUtil.OUTPOINT_LEN] == b'01000000');
            require(prevouts[RESERVE_B_INPUT_INDEX * TxUtil.OUTPOINT_LEN + 32 : (RESERVE_B_INPUT_INDEX + 1) * TxUtil.OUTPOINT_LEN] == b'02000000');
            require(prevouts[LP_INPUT_INDEX * TxUtil.OUTPOINT_LEN + 32 : (LP_INPUT_INDEX + 1) * TxUtil.OUTPOINT_LEN] == b'03000000');
        }

        int oldTokenAScriptLen = len(oldTokenAScript);
        int oldTokenBScriptLen = len(oldTokenBScript);
        int oldLpScriptLen = len(oldLpScript);

        // ========== AMM 逻辑 ==========
        int newReserveA = 0;
        int newReserveB = 0;
        int newLpReserve = lpReserve_old;
        bytes userOutput = b'';

        if (op == OP_SWAP) {
            // ===== 双向 swap 合并：A→B 与 B→A 共用同一公式 =====
            bytes inputTokenScript = b'';
            TxOutputProof inputProof = { b'', b'', b'', b'' };
            bytes outputTemplate = b''; // 输出 token 的旧储备脚本（决定输出模板）
            bytes inputTokenID = b'';
            int amountIn = 0;
            int amountOut = 0;
            int oldReserveIn = 0;
            int oldReserveOut = 0;
            int outSatoshis = 0;

            if (swapDirection == SWAP_A_TO_B) {
                inputTokenScript = userTokenScriptA;
                inputProof = userProofA;
                outputTemplate = oldTokenBScript;
                inputTokenID = this.tokenAID;
                amountIn = amountAIn;
                amountOut = amountBOut;
                oldReserveIn = reserveA_old;
                oldReserveOut = reserveB_old;
                outSatoshis = userBSatoshis;
            }
            else if (swapDirection == SWAP_B_TO_A) {
                inputTokenScript = userTokenScriptB;
                inputProof = userProofB;
                outputTemplate = oldTokenAScript;
                inputTokenID = this.tokenBID;
                amountIn = amountBIn;
                amountOut = amountAOut;
                oldReserveIn = reserveB_old;
                oldReserveOut = reserveA_old;
                outSatoshis = userASatoshis;
            }
            else {
                require(false);
            }

            readUserInput(inputTokenScript, inputProof, inputTokenID, poolAddress, userAddress, userSigLockAddress, prevouts, USER_INPUT_INDEX, amountIn);

            require(amountIn > 0);
            require(amountOut > 0);

            int effectiveIn = mul(amountIn, 10000 - this.feeBps) / 10000;
            require(effectiveIn > 0);

            // 输出必须严格等于恒定乘积公式（不允许低于公允值）
            int outCalc = mul(oldReserveOut, effectiveIn) / add(oldReserveIn, effectiveIn);
            require(outCalc == amountOut);

            int newReserveIn = add(oldReserveIn, amountIn);
            int newReserveOut = oldReserveOut - amountOut;
            require(newReserveOut > 0);
            require(mul(add(oldReserveIn, effectiveIn), newReserveOut) >= mul(oldReserveIn, oldReserveOut));

            // 用户输出模板必须是输出 token（A→B 用 FT-B，B→A 用 FT-A）
            bytes userOutScript = TokenProto.getNewTokenScript(
                outputTemplate,
                len(outputTemplate),
                userAddress,
                amountOut
            );
            userOutput = Utils.buildOutput(userOutScript, outSatoshis);

            if (swapDirection == SWAP_A_TO_B) {
                newReserveA = newReserveIn;
                newReserveB = newReserveOut;
            }
            else {
                newReserveA = newReserveOut;
                newReserveB = newReserveIn;
            }
        }
        else if (op == OP_ADD) {
            // 用户 FT-A（输入 4）/ FT-B（输入 5）校验
            readUserInput(userTokenScriptA, userProofA, this.tokenAID, poolAddress, userAddress, userSigLockAddress, prevouts, USER_INPUT_INDEX, amountAIn);
            readUserInput(userTokenScriptB, userProofB, this.tokenBID, poolAddress, userAddress, userSigLockAddress, prevouts, USER_INPUT_INDEX2, amountBIn);

            require(amountAIn > 0);
            require(amountBIn > 0);

            // 等比例约束
            require(mul(amountAIn, reserveB_old) == mul(amountBIn, reserveA_old));

            // LP 铸造量（按流通 LP 计算：S - lpReserve_old）
            int circulatingLp = lpTotalSupply - lpReserve_old;
            require(circulatingLp > 0);
            int lpMintA = mul(amountAIn, circulatingLp) / reserveA_old;
            int lpMintB = mul(amountBIn, circulatingLp) / reserveB_old;
            int lpMintCalc = lpMintA;
            if (lpMintB < lpMintA) {
                lpMintCalc = lpMintB;
            }
            require(lpMintCalc > 0);
            require(lpMintCalc <= lpReserve_old);
            require(lpMintCalc == lpMint);

            newReserveA = add(reserveA_old, amountAIn);
            newReserveB = add(reserveB_old, amountBIn);
            newLpReserve = lpReserve_old - lpMintCalc;

            // 用户 LP 输出
            bytes userLpScript = TokenProto.getNewTokenScript(
                oldLpScript,
                oldLpScriptLen,
                userAddress,
                lpMintCalc
            );
            userOutput = Utils.buildOutput(userLpScript, lpUserSatoshis);
        }
        else if (op == OP_REMOVE) {
            // 用户 LP 输入（输入 4）校验
            readUserLp(oldLpUserScript, lpUserProof, this.lpTokenID, this.lpTokenCodeHash, poolAddress, userAddress, userSigLockAddress, prevouts, USER_INPUT_INDEX, lpReturn);

            require(lpReturn > 0);
            require(lpReturn <= lpTotalSupply - lpReserve_old); // 不超过流通 LP

            // 赎回按流通 LP 计算：out = lpReturn * reserve / (S - lpReserve_old)
            int circulatingLp = lpTotalSupply - lpReserve_old;
            int outA = mul(lpReturn, reserveA_old) / circulatingLp;
            int outB = mul(lpReturn, reserveB_old) / circulatingLp;
            require(outA > 0);
            require(outB > 0);
            require(outA == amountAOut);
            require(outB == amountBOut);

            newReserveA = reserveA_old - outA;
            newReserveB = reserveB_old - outB;
            newLpReserve = lpReserve_old + lpReturn;

            bytes userAScript = TokenProto.getNewTokenScript(
                oldTokenAScript,
                oldTokenAScriptLen,
                userAddress,
                outA
            );
            bytes userBScript = TokenProto.getNewTokenScript(
                oldTokenBScript,
                oldTokenBScriptLen,
                userAddress,
                outB
            );
            userOutput = Utils.buildOutput(userAScript, userASatoshis) + Utils.buildOutput(userBScript, userBSatoshis);
        }
        else {
            require(false);
        }

        // ========== 只校验新状态：操作后池子储备必须满足最小储备 ==========
        require(newReserveA >= this.minReserve);
        require(newReserveB >= this.minReserve);

        // ========== 构造新池 UTXO 脚本 ==========
        // 只更新标准 FT 数据中的 genesisTxid（由 PoolGenesis issue 锚定后保持不变）；
        // 池状态（reserveA/B/lpReserve）不写入 data part，由“与旧池同 tx 的储备 FT”承载
        bytes newPoolScript = TokenProto.getNewGenesisScript(poolScript, poolScriptLen, genesisTxid);

        // 地址不变：output 池 UTXO 的 tokenAddress 必须与 input 一致
        require(TokenProto.getTokenAddress(newPoolScript, poolScriptLen) == poolTokenAddress);

        // genesisTxid 恒定 → newPoolAddress == poolAddress（新储备继续锁到同一池地址）
        bytes newPoolAddress = hash160(newPoolScript);

        // ========== 输出构造 ==========
        bytes outputs = b'';
        outputs += Utils.buildOutput(newPoolScript, poolSatoshis);

        bytes newReserveAScript = TokenProto.getNewTokenScript(oldTokenAScript, oldTokenAScriptLen, newPoolAddress, newReserveA);
        bytes newReserveBScript = TokenProto.getNewTokenScript(oldTokenBScript, oldTokenBScriptLen, newPoolAddress, newReserveB);
        bytes newLpReserveScript = TokenProto.getNewTokenScript(oldLpScript, oldLpScriptLen, newPoolAddress, newLpReserve);

        outputs += Utils.buildOutput(newReserveAScript, reserveASatoshis);
        outputs += Utils.buildOutput(newReserveBScript, reserveBSatoshis);
        outputs += Utils.buildOutput(newLpReserveScript, lpReserveSatoshis);
        outputs += userOutput;
        outputs += changeOutput;

        // changeOutput 不限制形态；储备唯一性由 prevout outputIndex 绑定保证
        // （池地址上的额外 FT 输出会永久锁死，但不能冒充储备）

        require(hash256(outputs) == SigHash.hashOutputs(txPreimage));
        require(Tx.checkPreimageSigHashTypeOCS(txPreimage, ProtoHeader.SIG_HASH_ALL));
    }
}
