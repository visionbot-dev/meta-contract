import "../protoheader.scrypt";
import "tokenProto.scrypt";

contract TokenSell {

    Ripemd160 mvcRecAddr;
    int mvcRecAmount;
    bytes tokenCodeHash;
    bytes tokenID;

    static const int OP_SELL = 1;
    static const int OP_CANCEL = 2;

    public function unlock(
        SigHashPreimage txPreimage,
        bytes tokenScript,       // only cancel need
        PubKey senderPubKey,     // only cancel need
        Sig senderSig,           // only cancel need
        int tokenOutputSatoshis, // only cancel need
        int op                   // 1 sell, 2 cancel
    ) {
        bytes outputs = b'';
        if (op == OP_SELL) {
            bytes outputScript = Utils.buildPublicKeyHashScript(this.mvcRecAddr);
            outputs = Utils.buildOutput(outputScript, this.mvcRecAmount);
        }
        else if (op == OP_CANCEL) {
            // check seller signature
            require(hash160(senderPubKey) == this.mvcRecAddr);
            require(checkSig(senderSig, senderPubKey));

            // verify the FT being refunded is the listed FT
            int tokenScriptLen = len(tokenScript);
            require(TokenProto.getScriptCodeHash(tokenScript, tokenScriptLen) == this.tokenCodeHash);
            require(TokenProto.getTokenID(tokenScript, tokenScriptLen) == this.tokenID);

            // refund the full FT amount back to the seller
            bytes newTokenScript = TokenProto.getNewTokenScript(
                tokenScript,
                tokenScriptLen,
                this.mvcRecAddr,
                TokenProto.getTokenAmount(tokenScript, tokenScriptLen)
            );
            outputs = Utils.buildOutput(newTokenScript, tokenOutputSatoshis);
        }
        else {
            require(false);
        }

        require(hash256(outputs) == SigHash.hashOutputs(txPreimage));
        require(Tx.checkPreimageSigHashTypeOCS(txPreimage, ProtoHeader.SIG_HASH_SINGLE));
    }
}
