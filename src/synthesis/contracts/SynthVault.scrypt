import "synthProto.scrypt";
import "../../mcp01/contract/protoheader.scrypt";
import "../../mcp01/contract/txUtil.scrypt";

/**
 * SynthVault — generic synthesis vault.
 *
 * All mutable/config state lives in the data part:
 *   vaultId(20) + recipeRoot(20) + ticketCodeHash(20)
 *   + governorPubKeyHash[3](60) + governorThreshold(1) + timelock(4)
 *
 * synthesize():
 *   Spends the vault control UTXO and authorizes one synthesis execution
 *   when a valid RecipeTicket input is present and its recipeHash is
 *   approved by the governance Merkle root.
 *
 * governUpdate():
 *   N-of-3 multisig + timelock. Spends the old vault and creates a new
 *   vault output with a new recipeRoot (new data part).
 */
contract SynthVault {

    public function synthesize(
        SigHashPreimage txPreimage,
        bytes prevouts,
        int ticketInputIndex,
        TxOutputProof ticketTxProof,
        bytes ticketScript,
        bytes merkleProof
    ) {
        require(Utils.fromLEUnsigned(SigHash.nVersion(txPreimage)) == ProtoHeader.TX_VERSION);
        require(hash256(prevouts) == SigHash.hashPrevouts(txPreimage));

        bytes vaultScript = SigHash.scriptCode(txPreimage);
        int slen = len(vaultScript);

        bytes vaultId = SynthProto.getVaultId(vaultScript, slen);
        bytes recipeRoot = SynthProto.getRecipeRoot(vaultScript, slen);
        bytes ticketCodeHash = SynthProto.getTicketCodeHash(vaultScript, slen);

        // 1. RecipeTicket UTXO must really exist in this tx.
        bytes ticketOutpoint = prevouts[ticketInputIndex * TxUtil.OUTPOINT_LEN : (ticketInputIndex + 1) * TxUtil.OUTPOINT_LEN];
        require(sha256(ticketScript) == ticketTxProof.scriptHash);
        TxUtil.verifyTxOutput(ticketTxProof, ticketOutpoint);

        // 2. The ticket must be our trusted RecipeTicket code.
        bytes ticketCode = SynthProto.getCodePart(ticketScript, len(ticketScript), SynthProto.TICKET_DATA_LEN);
        require(hash160(ticketCode) == ticketCodeHash);

        // 3. The ticket must bind to this vault and to a governance-approved recipe.
        require(SynthProto.getTicketVaultId(ticketScript, len(ticketScript)) == vaultId);
        bytes recipeHash = SynthProto.getTicketRecipeHash(ticketScript, len(ticketScript));
        SynthProto.verifyMerkleProof(recipeHash, merkleProof, recipeRoot);

        require(Tx.checkPreimageSigHashType(txPreimage, ProtoHeader.SIG_HASH_ALL));
    }

    public function governUpdate(
        SigHashPreimage txPreimage,
        bytes prevouts,
        bytes newVaultScript,
        int newVaultSatoshis,
        Ripemd160 changeAddress,
        int changeSatoshis,
        PubKey[3] pubKeys,
        Sig[3] sigs
    ) {
        require(Utils.fromLEUnsigned(SigHash.nVersion(txPreimage)) == ProtoHeader.TX_VERSION);
        require(hash256(prevouts) == SigHash.hashPrevouts(txPreimage));

        bytes vaultScript = SigHash.scriptCode(txPreimage);
        int slen = len(vaultScript);

        // Timelock: only allowed after the configured locktime.
        require(SigHash.nLocktime(txPreimage) >= SynthProto.getTimelock(vaultScript, slen));

        // Reject duplicate governor pubkeys.
        require(pubKeys[0] != pubKeys[1]);
        require(pubKeys[1] != pubKeys[2]);
        require(pubKeys[0] != pubKeys[2]);

        // N-of-3 multisig verification.
        int valid = 0;
        loop (3) : i {
            bool found = false;
            loop (3) : j {
                if (hash160(pubKeys[i]) == SynthProto.getGovernorPubKeyHash(vaultScript, slen, j)) {
                    found = true;
                }
            }
            if (found && checkSig(sigs[i], pubKeys[i])) {
                valid += 1;
            }
        }
        require(valid >= SynthProto.getGovernorThreshold(vaultScript, slen));

        // The new output must be a SynthVault with the same code part.
        int newSlen = len(newVaultScript);
        bytes newCode = SynthProto.getCodePart(newVaultScript, newSlen, SynthProto.VAULT_DATA_LEN);
        bytes oldCode = SynthProto.getCodePart(vaultScript, slen, SynthProto.VAULT_DATA_LEN);
        require(hash160(newCode) == hash160(oldCode));

        // Exactly two outputs: new vault + change.
        bytes outputs = Utils.buildOutput(newVaultScript, newVaultSatoshis);
        outputs += TxUtil.genMvcOutput(changeSatoshis, changeAddress);
        require(hash256(outputs) == SigHash.hashOutputs(txPreimage));

        require(Tx.checkPreimageSigHashType(txPreimage, ProtoHeader.SIG_HASH_ALL));
    }
}
