import "synthProto.scrypt";
import "../../mcp01/contract/protoheader.scrypt";
import "../../mcp01/contract/txUtil.scrypt";
import "../../mcp01/contract/token/tokenProto.scrypt";
import "../../mcp01/contract/nft/nftProto.scrypt";

/**
 * RecipeTicket — per-execution synthesis commitment.
 *
 * Data part (fixed capacity 2 FT outputs + 2 NFT outputs):
 *   base: recipeHash(20) + vaultId(20) + executorHash(20) + timelock(4)
 *         + ftOutCount(1) + nftOutCount(1)
 *   ftOut[2]: tokenID(20) + tokenCodeHash(20) + amount(8) + receiver(20) + satoshis(8)
 *   nftOut[2]: nftID(20) + nftCodeHash(20) + tokenIndex(8) + receiver(20) + satoshis(8)
 *
 * execute():
 *   Verifies the vault input, binds every FT/NFT output template to the vault
 *   address, reconstructs all tx outputs and checks hashOutputs. This makes
 *   the ticket a complete on-chain commitment for the synthesis tx.
 *
 * cancel():
 *   After timelock, the executor can recover the ticket dust.
 */
contract RecipeTicket {

    static const int MAX_OUT = 2;
    static const int MAX_OTHER_OUTPUT = 20;

    public function execute(
        SigHashPreimage txPreimage,
        bytes prevouts,
        // vault
        int vaultInputIndex,
        TxOutputProof vaultTxProof,
        bytes vaultScript,
        // output templates
        bytes ftOutTokenScriptArray,
        bytes ftOutSatoshisArray,
        bytes nftOutTokenScriptArray,
        bytes nftOutSatoshisArray,
        int nOutputs,
        bytes otherOutputArray,
        // executor
        PubKey executorPubKey,
        Sig executorSig
    ) {
        require(hash256(prevouts) == SigHash.hashPrevouts(txPreimage));

        bytes ticketScript = SigHash.scriptCode(txPreimage);
        int tlen = len(ticketScript);

        // ---- 1. verify vault input and bind to this ticket ----
        bytes vaultOutpoint = prevouts[vaultInputIndex * TxUtil.OUTPOINT_LEN : (vaultInputIndex + 1) * TxUtil.OUTPOINT_LEN];
        require(sha256(vaultScript) == vaultTxProof.scriptHash);
        TxUtil.verifyTxOutput(vaultTxProof, vaultOutpoint);

        int vlen = len(vaultScript);
        require(SynthProto.getVaultId(vaultScript, vlen) == SynthProto.getTicketVaultId(ticketScript, tlen));
        bytes vaultAddress = ripemd160(sha256(vaultScript));

        // ---- 2. reconstruct outputs ----
        bytes outputs = b'';
        int ftScriptPos = 0;
        loop (MAX_OUT) : i {
            if (i < SynthProto.getTicketFtOutCount(ticketScript, tlen)) {
                // parse [len(4B) + tokenScript]
                int scriptLen = Utils.fromLEUnsigned(ftOutTokenScriptArray[ftScriptPos : ftScriptPos + 4]);
                ftScriptPos += 4;
                bytes tokenScript = ftOutTokenScriptArray[ftScriptPos : ftScriptPos + scriptLen];
                ftScriptPos += scriptLen;

                int tokenScriptLen = len(tokenScript);
                require(TokenProto.getTokenID(tokenScript, tokenScriptLen) == SynthProto.getTicketFtOutTokenID(ticketScript, tlen, i));
                require(TokenProto.getScriptCodeHash(tokenScript, tokenScriptLen) == SynthProto.getTicketFtOutTokenCodeHash(ticketScript, tlen, i));
                require(TokenProto.getTokenAddress(tokenScript, tokenScriptLen) == vaultAddress);

                bytes outScript = TokenProto.getNewTokenScript(
                    tokenScript,
                    tokenScriptLen,
                    SynthProto.getTicketFtOutReceiver(ticketScript, tlen, i),
                    SynthProto.getTicketFtOutAmount(ticketScript, tlen, i)
                );
                int outSatoshis = Utils.fromLEUnsigned(ftOutSatoshisArray[i * 8 : (i + 1) * 8]);
                outputs += Utils.buildOutput(outScript, outSatoshis);
            }
        }

        int nftScriptPos = 0;
        loop (MAX_OUT) : i {
            if (i < SynthProto.getTicketNftOutCount(ticketScript, tlen)) {
                int scriptLen = Utils.fromLEUnsigned(nftOutTokenScriptArray[nftScriptPos : nftScriptPos + 4]);
                nftScriptPos += 4;
                bytes nftScript = nftOutTokenScriptArray[nftScriptPos : nftScriptPos + scriptLen];
                nftScriptPos += scriptLen;

                int nftScriptLen = len(nftScript);
                require(NftProto.getNftID(nftScript, nftScriptLen) == SynthProto.getTicketNftOutTokenID(ticketScript, tlen, i));
                require(NftProto.getScriptCodeHash(nftScript, nftScriptLen) == SynthProto.getTicketNftOutTokenCodeHash(ticketScript, tlen, i));
                require(NftProto.getNftAddress(nftScript, nftScriptLen) == vaultAddress);

                bytes outScript = NftProto.getNewNftScript(
                    nftScript,
                    nftScriptLen,
                    SynthProto.getTicketNftOutReceiver(ticketScript, tlen, i)
                );
                int outSatoshis = Utils.fromLEUnsigned(nftOutSatoshisArray[i * 8 : (i + 1) * 8]);
                outputs += Utils.buildOutput(outScript, outSatoshis);
            }
        }

        // other outputs: new vault, OP_RETURN, change, etc.
        int otherPos = 0;
        int nOther = nOutputs - SynthProto.getTicketFtOutCount(ticketScript, tlen) - SynthProto.getTicketNftOutCount(ticketScript, tlen);
        loop (MAX_OTHER_OUTPUT) : i {
            if (i < nOther) {
                int outputLen = Utils.fromLEUnsigned(otherOutputArray[otherPos : otherPos + 4]);
                bytes output = otherOutputArray[otherPos + 4 : otherPos + 4 + outputLen];
                outputs += output;
                otherPos += 4 + outputLen;
            }
        }

        require(hash256(outputs) == SigHash.hashOutputs(txPreimage));

        // ---- 3. executor authorization (anti front-running) ----
        require(hash160(executorPubKey) == SynthProto.getTicketExecutorHash(ticketScript, tlen));
        require(checkSig(executorSig, executorPubKey));

        require(Tx.checkPreimageSigHashType(txPreimage, ProtoHeader.SIG_HASH_ALL));
    }

    public function cancel(
        SigHashPreimage txPreimage,
        int outputSatoshis,
        PubKey creatorPubKey,
        Sig creatorSig
    ) {
        bytes ticketScript = SigHash.scriptCode(txPreimage);
        int tlen = len(ticketScript);

        require(SigHash.nLocktime(txPreimage) >= SynthProto.getTicketTimelock(ticketScript, tlen));
        require(hash160(creatorPubKey) == SynthProto.getTicketExecutorHash(ticketScript, tlen));
        require(checkSig(creatorSig, creatorPubKey));

        bytes output = Utils.buildOutput(
            Utils.buildPublicKeyHashScript(Ripemd160(SynthProto.getTicketExecutorHash(ticketScript, tlen))),
            outputSatoshis
        );
        require(hash256(output) == SigHash.hashOutputs(txPreimage));

        require(Tx.checkPreimageSigHashType(txPreimage, ProtoHeader.SIG_HASH_ALL));
    }
}
