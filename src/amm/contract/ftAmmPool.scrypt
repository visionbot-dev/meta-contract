import "../../mcp02/contract/token/tokenProto.scrypt";
import "../../mcp02/contract/protoheader.scrypt";
import "../../mcp02/contract/txUtil.scrypt";
import "../../mcp02/contract/backtrace.scrypt";

/**
 * FtAmmPool：MCP02 FT-FT 恒定乘积 AMM 池（v3.0）
 *
 * 设计要点：
 * - 池状态（reserveA/reserveB/lpReserve）不写入 data part，
 *   由“与旧池 UTXO 同一笔交易创建、固定输出序号”的储备 FT 承载；
 * - 储备 FT 必须与旧池同 tx（prevout txid 一致），且输出序号固定
 *   （pool=0, reserveA=1, reserveB=2, lpReserve=3），
 *   禁止第三方转入/捐赠 UTXO 参与；
 * - 池 UTXO data part 只保留标准 MCP02 FT 数据（静态），tokenAddress
 *   每次更新 input/output 一致，现有索引器可识别为普通 FT 找回；
 * - 池 UTXO 采用 TokenGenesis 链式更新：genesisTxid 首次锚定
 *   CREATE_POOL outpoint，后续每次操作通过 Backtrace.verify 回溯。
 */
contract FtAmmPool {
    // 构造参数（不可变，写入 code part）
    bytes tokenACodeHash;
    bytes tokenAID;
    bytes tokenBCodeHash;
    bytes tokenBID;
    bytes lpTokenCodeHash;
    bytes lpTokenID;
    int lpTotalSupply;
    int minReserve;
    int feeBps;
    static const int OP_SWAP = 1;
    static const int OP_ADD = 2;
    static const int OP_REMOVE = 3;
    static const int SWAP_A_TO_B = 1;
    static const int SWAP_B_TO_A = 2;

    // 64 位有符号 int 最大值（M2 溢出防护）
    static const int INT_MAX = 9223372036854775807;

    // 安全乘法：溢出前拒绝
    static function mul(int a, int b) : int {
        require(a == 0 || b <= INT_MAX / a);
        return a * b;
    }

    // 安全加法：溢出前拒绝
    static function add(int a, int b) : int {
        require(a <= INT_MAX - b);
        return a + b;
    }

    public function unlock(
        SigHashPreimage txPreimage,
        bytes prevouts,
        bytes poolScript,
        TxOutputProof poolProof,
        int op,
        int swapDirection,
        // 池内储备 FT 输入
        bytes oldTokenAScript,
        bytes oldTokenBScript,
        bytes oldLpScript,
        TxOutputProof proofA,
        TxOutputProof proofB,
        TxOutputProof proofLp,
        int reserveAInputIndex,
        int reserveBInputIndex,
        int lpInputIndex,
        // 用户输入
        bytes userTokenScriptA,
        bytes userTokenScriptB,
        TxOutputProof userProofA,
        TxOutputProof userProofB,
        int userInputIndexA,
        int userInputIndexB,
        int amountAIn,
        int amountBIn,
        bytes userAddress,
        // 输出金额
        int amountAOut,
        int amountBOut,
        int lpMint,
        int lpReturn,
        bytes changeOutput,
        // remove 用：用户 LP 输入
        int lpReturnInputIndex,
        bytes oldLpUserScript,
        TxOutputProof lpUserProof,
        // 输出 satoshis
        int poolSatoshis,
        int reserveASatoshis,
        int reserveBSatoshis,
        int lpReserveSatoshis,
        int userASatoshis,
        int userBSatoshis,
        int lpUserSatoshis,
        // TokenGenesis 链式更新证明
        bytes poolTxHeader,
        int prevPoolInputIndex,
        TxInputProof poolTxInputProof,
        bytes prevPoolTxHeader,
        bytes prevPoolTxOutputHashProof,
        bytes prevPoolTxOutputSatoshiBytes
    ) {
        require(hash256(prevouts) == SigHash.hashPrevouts(txPreimage));

        // 池输入必须是当前 input 的 prevout，且传入脚本必须是链上真实完整锁定脚本
        // （SigHash.scriptCode 只是 OP_CODESEPARATOR 后的片段，不能用来算池地址/构造新池输出）
        bytes thisOutpoint = SigHash.outpoint(txPreimage);
        TxUtil.verifyTxOutput(poolProof, thisOutpoint);
        require(sha256(poolScript) == poolProof.scriptHash);
        int poolScriptLen = len(poolScript);

        // ========== 读取池 tokenAddress（用于保证 input/output 一致） ==========
        bytes poolTokenAddress = TokenProto.getTokenAddress(poolScript, poolScriptLen);

        // ========== TokenGenesis 链式更新 ==========
        bytes genesisTxid = TokenProto.getGenesisTxid(poolScript, poolScriptLen);
        bool isFirst = false;
        if (genesisTxid == ProtoHeader.NULL_GENESIS_TXID) {
            isFirst = true;
            genesisTxid = thisOutpoint;
        }
        if (!isFirst) {
            bytes prevScriptHash = sha256(poolScript);
            TxOutputProof prevPoolTxProof = {
                prevPoolTxHeader,
                prevPoolTxOutputHashProof,
                prevPoolTxOutputSatoshiBytes,
                prevScriptHash
            };
            Backtrace.verify(
                thisOutpoint,
                poolTxHeader,
                prevPoolInputIndex,
                prevPoolTxProof,
                genesisTxid,
                poolTxInputProof
            );
        }

        // ========== 校验池内储备 FT 输入（必须与旧池同 tx，且读金额即 reserve） ==========
        bytes poolAddress = hash160(poolScript);
        bytes poolTxid = SigHash.outpoint(txPreimage)[: 32];

        TxUtil.verifyTxOutput(proofA, prevouts[reserveAInputIndex * TxUtil.OUTPOINT_LEN : (reserveAInputIndex + 1) * TxUtil.OUTPOINT_LEN]);
        TxUtil.verifyTxOutput(proofB, prevouts[reserveBInputIndex * TxUtil.OUTPOINT_LEN : (reserveBInputIndex + 1) * TxUtil.OUTPOINT_LEN]);
        TxUtil.verifyTxOutput(proofLp, prevouts[lpInputIndex * TxUtil.OUTPOINT_LEN : (lpInputIndex + 1) * TxUtil.OUTPOINT_LEN]);

        // 绑定 proof.scriptHash：传入脚本必须是链上真实 UTXO 脚本（防伪造储备金额）
        require(sha256(oldTokenAScript) == proofA.scriptHash);
        require(sha256(oldTokenBScript) == proofB.scriptHash);
        require(sha256(oldLpScript) == proofLp.scriptHash);

        // 储备 FT 必须来自创建旧池 UTXO 的同一笔交易（禁止第三方转入/捐赠 UTXO 参与）
        require(prevouts[reserveAInputIndex * TxUtil.OUTPOINT_LEN : reserveAInputIndex * TxUtil.OUTPOINT_LEN + 32] == poolTxid);
        require(prevouts[reserveBInputIndex * TxUtil.OUTPOINT_LEN : reserveBInputIndex * TxUtil.OUTPOINT_LEN + 32] == poolTxid);
        require(prevouts[lpInputIndex * TxUtil.OUTPOINT_LEN : lpInputIndex * TxUtil.OUTPOINT_LEN + 32] == poolTxid);

        // 固定输出布局：pool=0, reserveA=1, reserveB=2, lpReserve=3
        // 只比 txid 不够：同一 tx 的 changeOutput 可能塞入池地址上的额外 FT，
        // 必须同时绑定 prevout outputIndex，确保取到的是“规范储备输出”
        require(SigHash.outpoint(txPreimage)[32 : 36] == b'00000000');
        require(prevouts[reserveAInputIndex * TxUtil.OUTPOINT_LEN + 32 : (reserveAInputIndex + 1) * TxUtil.OUTPOINT_LEN] == b'01000000');
        require(prevouts[reserveBInputIndex * TxUtil.OUTPOINT_LEN + 32 : (reserveBInputIndex + 1) * TxUtil.OUTPOINT_LEN] == b'02000000');
        require(prevouts[lpInputIndex * TxUtil.OUTPOINT_LEN + 32 : (lpInputIndex + 1) * TxUtil.OUTPOINT_LEN] == b'03000000');

        int oldTokenAScriptLen = len(oldTokenAScript);
        int oldTokenBScriptLen = len(oldTokenBScript);
        int oldLpScriptLen = len(oldLpScript);

        require(TokenProto.getTokenID(oldTokenAScript, oldTokenAScriptLen) == this.tokenAID);
        require(TokenProto.getScriptCodeHash(oldTokenAScript, oldTokenAScriptLen) == this.tokenACodeHash);
        require(TokenProto.getTokenAddress(oldTokenAScript, oldTokenAScriptLen) == poolAddress);
        int reserveA_old = TokenProto.getTokenAmount(oldTokenAScript, oldTokenAScriptLen);

        require(TokenProto.getTokenID(oldTokenBScript, oldTokenBScriptLen) == this.tokenBID);
        require(TokenProto.getScriptCodeHash(oldTokenBScript, oldTokenBScriptLen) == this.tokenBCodeHash);
        require(TokenProto.getTokenAddress(oldTokenBScript, oldTokenBScriptLen) == poolAddress);
        int reserveB_old = TokenProto.getTokenAmount(oldTokenBScript, oldTokenBScriptLen);

        require(TokenProto.getTokenID(oldLpScript, oldLpScriptLen) == this.lpTokenID);
        require(TokenProto.getScriptCodeHash(oldLpScript, oldLpScriptLen) == this.lpTokenCodeHash);
        require(TokenProto.getTokenAddress(oldLpScript, oldLpScriptLen) == poolAddress);
        int lpReserve_old = TokenProto.getTokenAmount(oldLpScript, oldLpScriptLen);

        // ========== AMM 逻辑 ==========
        int newReserveA = 0;
        int newReserveB = 0;
        int newLpReserve = lpReserve_old;
        bytes userOutput = b'';

        if (op == OP_SWAP) {
            if (swapDirection == SWAP_A_TO_B) {
                // ===== A → B：用户卖 FT-A，买 FT-B =====
                TxUtil.verifyTxOutput(userProofA, prevouts[userInputIndexA * TxUtil.OUTPOINT_LEN : (userInputIndexA + 1) * TxUtil.OUTPOINT_LEN]);
                require(sha256(userTokenScriptA) == userProofA.scriptHash); // 绑定真实用户脚本
                int userTokenScriptALen = len(userTokenScriptA);
                require(TokenProto.getTokenID(userTokenScriptA, userTokenScriptALen) == this.tokenAID);
                require(TokenProto.getTokenAmount(userTokenScriptA, userTokenScriptALen) == amountAIn);
                require(TokenProto.getTokenAddress(userTokenScriptA, userTokenScriptALen) != poolAddress);
                require(TokenProto.getTokenAddress(userTokenScriptA, userTokenScriptALen) == userAddress);

                require(amountAIn > 0);
                require(amountBOut > 0);

                int effectiveInA = mul(amountAIn, 10000 - this.feeBps) / 10000;
                require(effectiveInA > 0);

                // 输出必须严格等于恒定乘积公式（不允许低于公允值）
                int outBCalc = mul(reserveB_old, effectiveInA) / add(reserveA_old, effectiveInA);
                require(outBCalc == amountBOut);

                newReserveA = add(reserveA_old, amountAIn);
                newReserveB = reserveB_old - amountBOut;
                require(newReserveB > 0);
                require(mul(add(reserveA_old, effectiveInA), newReserveB) >= mul(reserveA_old, reserveB_old));

                // 用户 FT-B 输出（模板必须是 FT-B，不能用 FT-A）
                bytes userBScript = TokenProto.getNewTokenScript(
                    oldTokenBScript,
                    oldTokenBScriptLen,
                    userAddress,
                    amountBOut
                );
                userOutput = Utils.buildOutput(userBScript, userBSatoshis);
            }
            else if (swapDirection == SWAP_B_TO_A) {
                // ===== B → A：用户卖 FT-B，买 FT-A =====
                TxUtil.verifyTxOutput(userProofB, prevouts[userInputIndexB * TxUtil.OUTPOINT_LEN : (userInputIndexB + 1) * TxUtil.OUTPOINT_LEN]);
                require(sha256(userTokenScriptB) == userProofB.scriptHash); // 绑定真实用户脚本
                int userTokenScriptBLen = len(userTokenScriptB);
                require(TokenProto.getTokenID(userTokenScriptB, userTokenScriptBLen) == this.tokenBID);
                require(TokenProto.getTokenAmount(userTokenScriptB, userTokenScriptBLen) == amountBIn);
                require(TokenProto.getTokenAddress(userTokenScriptB, userTokenScriptBLen) != poolAddress);
                require(TokenProto.getTokenAddress(userTokenScriptB, userTokenScriptBLen) == userAddress);

                require(amountBIn > 0);
                require(amountAOut > 0);

                int effectiveInB = mul(amountBIn, 10000 - this.feeBps) / 10000;
                require(effectiveInB > 0);

                // 输出必须严格等于恒定乘积公式
                int outACalc = mul(reserveA_old, effectiveInB) / add(reserveB_old, effectiveInB);
                require(outACalc == amountAOut);

                newReserveA = reserveA_old - amountAOut;
                newReserveB = add(reserveB_old, amountBIn);
                require(newReserveA > 0);
                require(mul(add(reserveB_old, effectiveInB), newReserveA) >= mul(reserveA_old, reserveB_old));

                // 用户 FT-A 输出（模板必须是 FT-A）
                bytes userAScript = TokenProto.getNewTokenScript(
                    oldTokenAScript,
                    oldTokenAScriptLen,
                    userAddress,
                    amountAOut
                );
                userOutput = Utils.buildOutput(userAScript, userASatoshis);
            }
            else {
                require(false);
            }
        }
        else if (op == OP_ADD) {
            // 用户 FT-A / FT-B 输入校验
            TxUtil.verifyTxOutput(userProofA, prevouts[userInputIndexA * TxUtil.OUTPOINT_LEN : (userInputIndexA + 1) * TxUtil.OUTPOINT_LEN]);
            TxUtil.verifyTxOutput(userProofB, prevouts[userInputIndexB * TxUtil.OUTPOINT_LEN : (userInputIndexB + 1) * TxUtil.OUTPOINT_LEN]);
            require(sha256(userTokenScriptA) == userProofA.scriptHash); // 绑定真实用户脚本
            require(sha256(userTokenScriptB) == userProofB.scriptHash);
            int userTokenScriptALen = len(userTokenScriptA);
            int userTokenScriptBLen = len(userTokenScriptB);
            require(TokenProto.getTokenID(userTokenScriptA, userTokenScriptALen) == this.tokenAID);
            require(TokenProto.getTokenID(userTokenScriptB, userTokenScriptBLen) == this.tokenBID);
            require(TokenProto.getTokenAmount(userTokenScriptA, userTokenScriptALen) == amountAIn);
            require(TokenProto.getTokenAmount(userTokenScriptB, userTokenScriptBLen) == amountBIn);
            require(TokenProto.getTokenAddress(userTokenScriptA, userTokenScriptALen) != poolAddress);
            require(TokenProto.getTokenAddress(userTokenScriptB, userTokenScriptBLen) != poolAddress);
            require(TokenProto.getTokenAddress(userTokenScriptA, userTokenScriptALen) == userAddress);
            require(TokenProto.getTokenAddress(userTokenScriptB, userTokenScriptBLen) == userAddress);

            require(amountAIn > 0);
            require(amountBIn > 0);

            // 等比例约束
            require(mul(amountAIn, reserveB_old) == mul(amountBIn, reserveA_old));

            // LP 铸造量（按流通 LP 计算：S - lpReserve_old）
            int circulatingLp = this.lpTotalSupply - lpReserve_old;
            require(circulatingLp > 0);
            int lpMintA = mul(amountAIn, circulatingLp) / reserveA_old;
            int lpMintB = mul(amountBIn, circulatingLp) / reserveB_old;
            int lpMintCalc = lpMintA;
            if (lpMintB < lpMintA) {
                lpMintCalc = lpMintB;
            }
            require(lpMintCalc > 0);
            require(lpMintCalc <= lpReserve_old);
            require(lpMintCalc == lpMint);

            newReserveA = add(reserveA_old, amountAIn);
            newReserveB = add(reserveB_old, amountBIn);
            newLpReserve = lpReserve_old - lpMintCalc;

            // 用户 LP 输出
            bytes userLpScript = TokenProto.getNewTokenScript(
                oldLpScript,
                oldLpScriptLen,
                userAddress,
                lpMintCalc
            );
            userOutput = Utils.buildOutput(userLpScript, lpUserSatoshis);
        }
        else if (op == OP_REMOVE) {
            // 用户 LP 输入校验
            TxUtil.verifyTxOutput(lpUserProof, prevouts[lpReturnInputIndex * TxUtil.OUTPOINT_LEN : (lpReturnInputIndex + 1) * TxUtil.OUTPOINT_LEN]);
            require(sha256(oldLpUserScript) == lpUserProof.scriptHash); // 绑定真实用户脚本
            int oldLpUserScriptLen = len(oldLpUserScript);
            require(TokenProto.getTokenID(oldLpUserScript, oldLpUserScriptLen) == this.lpTokenID);
            require(TokenProto.getScriptCodeHash(oldLpUserScript, oldLpUserScriptLen) == this.lpTokenCodeHash);
            require(TokenProto.getTokenAmount(oldLpUserScript, oldLpUserScriptLen) == lpReturn);
            require(TokenProto.getTokenAddress(oldLpUserScript, oldLpUserScriptLen) != poolAddress);
            require(TokenProto.getTokenAddress(oldLpUserScript, oldLpUserScriptLen) == userAddress);

            require(lpReturn > 0);
            require(lpReturn <= this.lpTotalSupply - lpReserve_old); // 不超过流通 LP

            // 赎回按流通 LP 计算：out = lpReturn * reserve / (S - lpReserve_old)
            int circulatingLp = this.lpTotalSupply - lpReserve_old;
            int outA = mul(lpReturn, reserveA_old) / circulatingLp;
            int outB = mul(lpReturn, reserveB_old) / circulatingLp;
            require(outA > 0);
            require(outB > 0);
            require(outA == amountAOut);
            require(outB == amountBOut);

            newReserveA = reserveA_old - outA;
            newReserveB = reserveB_old - outB;
            newLpReserve = lpReserve_old + lpReturn;

            bytes userAScript = TokenProto.getNewTokenScript(
                oldTokenAScript,
                oldTokenAScriptLen,
                userAddress,
                outA
            );
            bytes userBScript = TokenProto.getNewTokenScript(
                oldTokenBScript,
                oldTokenBScriptLen,
                userAddress,
                outB
            );
            userOutput = Utils.buildOutput(userAScript, userASatoshis) + Utils.buildOutput(userBScript, userBSatoshis);
        }
        else {
            require(false);
        }

        // ========== 只校验新状态：操作后池子储备必须满足最小储备 ==========
        require(newReserveA >= this.minReserve);
        require(newReserveB >= this.minReserve);

        // ========== 构造新池 UTXO 脚本 ==========
        // 只更新标准 FT 数据中的 genesisTxid（首次写入 thisOutpoint，之后保持不变）；
        // 池状态（reserveA/B/lpReserve）不写入 data part，由“与旧池同 tx 的储备 FT”承载
        bytes newPoolScript = TokenProto.getNewGenesisScript(poolScript, poolScriptLen, genesisTxid);

        // 地址不变：output 池 UTXO 的 tokenAddress 必须与 input 一致
        require(TokenProto.getTokenAddress(newPoolScript, poolScriptLen) == poolTokenAddress);

        // ========== 输出构造 ==========
        bytes outputs = b'';
        outputs += Utils.buildOutput(newPoolScript, poolSatoshis);

        bytes newReserveAScript = TokenProto.getNewTokenScript(oldTokenAScript, oldTokenAScriptLen, poolAddress, newReserveA);
        bytes newReserveBScript = TokenProto.getNewTokenScript(oldTokenBScript, oldTokenBScriptLen, poolAddress, newReserveB);
        bytes newLpReserveScript = TokenProto.getNewTokenScript(oldLpScript, oldLpScriptLen, poolAddress, newLpReserve);

        outputs += Utils.buildOutput(newReserveAScript, reserveASatoshis);
        outputs += Utils.buildOutput(newReserveBScript, reserveBSatoshis);
        outputs += Utils.buildOutput(newLpReserveScript, lpReserveSatoshis);
        outputs += userOutput;
        outputs += changeOutput;

        // changeOutput 不限制形态；储备唯一性由 prevout outputIndex 绑定保证
        // （池地址上的额外 FT 输出会永久锁死，但不能冒充储备）

        require(hash256(outputs) == SigHash.hashOutputs(txPreimage));
        require(Tx.checkPreimageSigHashTypeOCS(txPreimage, ProtoHeader.SIG_HASH_ALL));
    }
}
